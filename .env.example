# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
# Generate both with: make keys
SECRET_KEY=change-me
TOKEN_ENCRYPTION_KEY=
# Operator login. Prefer ADMIN_PASSWORD_HASH (make hash-password); ADMIN_PASSWORD is a first-run convenience.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
PUBLIC_BASE_URL=http://localhost:8000
# DATABASE_URL=sqlite:///./data/wakeful.db         (default)
# DATABASE_URL=postgresql+psycopg://wakeful:wakeful@localhost:5432/wakeful

# ---- Fanvue (official API) ----
# mock = simulated account with fictional fans (default, safe). live = your real Fanvue account via OAuth.
FANVUE_MODE=mock
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
# Optional, only if you expose a public HTTPS URL for webhooks:
FANVUE_WEBHOOK_SECRET=
FANVUE_POLL_SECONDS=60

# ---- AI provider ----
# mock | anthropic | openai
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# USD per 1M tokens, used for cost tracking
AI_PRICE_INPUT_PER_MTOK=3.0
AI_PRICE_OUTPUT_PER_MTOK=15.0

RETENTION_DAYS_MESSAGES=365
